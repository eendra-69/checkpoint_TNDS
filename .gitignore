# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
#
# The Next.js demo app lives in demo/; the repo root is a static presentation
# site with no build step and no dependencies. Patterns below are deliberately
# unanchored so they cover demo/ as well as the root.

# dependencies
node_modules/
.pnpm-store/

# next.js
.next/
out/

# production
build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files. The app's .env.local lives in demo/ and must never be committed;
# .env.example is the checked-in template.
.env*
!.env.example

# vercel
.vercel/

# typescript
*.tsbuildinfo
next-env.d.ts

# image-generation scratch. The prompts (demo/.mcode/*.json) are kept because
# they document how the sprite sheets were produced, but the downloaded
# intermediates in out/ are duplicates of demo/public/worlds/raw/, which is
# the directory the asset pipeline actually reads.
.mcode/out/

# playwright (unanchored so they also cover demo/)
test-results/
playwright-report/
blob-report/
