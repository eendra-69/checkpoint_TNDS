{
  "name": "tasco-tnds-renewal-journey",
  "version": "0.2.1",
  "private": true,
  "description": "Presentation site for the TASCO TNDS renewal demo (BeyondPilot x Tasco, GenAI Fund). The Next.js app lives in demo/.",
  "scripts": {
    "site": "node scripts/serve-site.mjs",
    "dev": "npm --prefix demo run dev",
    "build": "npm --prefix demo run build",
    "start": "npm --prefix demo run start",
    "lint": "npm --prefix demo run lint",
    "typecheck": "npm --prefix demo exec -- tsc --noEmit",
    "assets": "npm --prefix demo run office:assets",
    "setup": "npm --prefix demo install"
  }
}