# Auth / encryption
AUTH_SECRET=replace-with-long-random-string
SETTINGS_SECRET=replace-with-long-random-string

# Optional: Upstash Redis (falls back to in-memory if unset)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: AI (demo mode works without these)
AI_GATEWAY_API_KEY=
AI_MODEL=google/gemini-2.5-flash
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional: ElevenLabs voice
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

NEXT_PUBLIC_APP_URL=http://localhost:3000